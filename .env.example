DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
AI_PROVIDER="openai"
AI_MODEL="gpt-4.1-mini"
OPENAI_API_KEY="replace-with-openai-api-key"
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID="replace-with-google-oauth-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-oauth-client-secret"
AUTH_ADMIN_EMAILS="owner@example.com"

# EmojiFi onchain claim config. Base Sepolia is 84532; Base mainnet is 8453.
NEXT_PUBLIC_EMOJI_CHAIN_ID="84532"
NEXT_PUBLIC_EMOJI_TOKEN_ADDRESS="0x0000000000000000000000000000000000000000"
NEXT_PUBLIC_EMOJI_CLAIM_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
NEXT_PUBLIC_EMOJI_STAKING_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
NEXT_PUBLIC_EMOJI_DUMP_VAULT_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
NEXT_PUBLIC_DEV_DONATION_ADDRESS="0xreplace-with-dev-donation-address"
# Base Sepolia Circle USDC. For Base mainnet, set the production USDC contract before launch.
NEXT_PUBLIC_DONATION_USDC_ADDRESS="0x036CbD53842c5426634e7929541eC2318f3dCF7e"
EMOJI_CLAIM_SIGNER_PRIVATE_KEY="0xreplace-with-server-claim-signer-private-key"

# EmojiFi deployment config. Use a burner deployer with enough ETH for gas.
BASE_RPC_URL="https://sepolia.base.org"
DEPLOYER_PRIVATE_KEY="0xreplace-with-deployer-private-key"
EMOJI_CLAIM_SIGNER_ADDRESS="0xreplace-with-server-claim-signer-address"
EMOJI_OWNER_ADDRESS="0xreplace-with-owner-address"
EMOJI_OWNER_PRIVATE_KEY="0xoptional-owner-private-key-if-owner-is-not-deployer"
EMOJI_RESERVE_ADDRESS="0xreplace-with-1-percent-reserve-address"
EMOJI_TOKEN_ADDRESS="0x0000000000000000000000000000000000000000"
