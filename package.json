{
  "name": "dopamine-summer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "contracts:test": "HOME=$PWD/.hardhat-home HARDHAT_DISABLE_TELEMETRY=1 hardhat test nodejs test/emoji-contracts.ts",
    "contracts:preflight": "node scripts/preflight-emojifi-deploy.mjs",
    "contracts:deploy": "node scripts/deploy-emojifi.mjs",
    "contracts:grant-minter": "node scripts/grant-emojifi-minter.mjs",
    "contracts:verify": "node scripts/verify-emojifi-deploy.mjs",
    "postinstall": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@prisma/client": "^5.22.0",
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.52.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "hardhat": "^3.9.0",
    "prisma": "^5.22.0",
    "solc": "^0.8.35",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
